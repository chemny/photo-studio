{
  "schema_version": 7,
  "default_preset": "urban_light_wedding",
  "question_policy": {
    "max_consolidated_rounds": 1,
    "ask_when": [
      "two_subject_attire_mapping_is_ambiguous",
      "three_or_more_subjects_require_selection",
      "specified_real_partner_reference_is_missing"
    ],
    "do_not_ask_when_default_available": [
      "style",
      "scene",
      "framing",
      "aspect_ratio",
      "retouching",
      "quantity"
    ],
    "recommended_attire_mapping": {
      "subject_a": "light_wedding_formalwear",
      "subject_b": "dark_or_scene_appropriate_formalwear"
    }
  },
  "subject_routing": {
    "one_subject": "solo_wedding_portrait_without_added_partner",
    "two_subjects": "couple_wedding_portrait",
    "three_or_more_subjects": "ask_once_family_group_or_select_two",
    "missing_real_partner_reference": "request_reference_and_do_not_fabricate"
  },
  "shared_defaults": {
    "aspect_ratio": "4:5",
    "framing": "varied_editorial",
    "expression": "youthful_relaxed_or_joyful",
    "gaze": "camera_forward_with_limited_story_exceptions",
    "hand_emphasis": "low",
    "retouching": "light_natural_skin_texture",
    "format": "JPG",
    "quantity": 1
