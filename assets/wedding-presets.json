    "max_pure_back_view_panels_default": 0,
    "min_full_or_near_full_body_panels_nine_panel": 3,
    "max_walking_hand_in_hand_panels": 1,
    "max_repeated_action_panels": 1,
    "max_side_by_side_upright_ratio": 0.45,
    "required_scene_categories": ["interior", "urban", "nature"],
    "example_scene_slots": ["garden", "interior", "conservatory", "sandy_beach", "chinese_courtyard", "modern_architecture", "city_night", "woodland_meadow", "minimal_studio"],
    "allow_user_requested_scene_substitution": true,
    "require_substitute_scene_distinct_from_other_panels": true,
    "required_pose_families": [
      "seated_standing_height_contrast",
      "spin_dance_or_dynamic_motion",
      "formal_full_body_wedding_portrait",
      "foreground_background_depth",
      "close_intimate_action"
