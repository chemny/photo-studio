    "require_varied_actions": true,
    "require_varied_gaze": true,
    "require_varied_body_orientation": true,
    "require_varied_contact_point": true,
    "require_varied_subject_distance": true,
    "require_varied_framing_or_camera_angle": true,
    "require_scene_specific_lighting": true,
    "default_stage": "single_concept_grid"
